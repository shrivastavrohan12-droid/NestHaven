
<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <!-- Listing Title -->
  <div class="col-md-8 offset-md-2">
    <h3><%= listing.title %></h3>
  </div>

  <!-- Listing Details -->
  <div class="card col-md-8 offset-md-2 show-card listing-card">
    <% if (listing.image && listing.image.url) { %>
      <img
        src="<%= listing.image.url %>"
        class="card-img-top show-img"
        alt="<%= listing.title %>"
      />
    <% } %>

    <div class="card-body">
      <p class="card-text">
        Owned by
        <i>
          <%= listing.owner ? listing.owner.username : "Unknown" %>
        </i>
      </p>

      <p class="card-text">
        <%= listing.description %>
        <br />
        <% if (currUser) { %>₹ <%= listing.price.toLocaleString("en-IN") %> / night<% } else { %><a href="/login">Log in to view price and booking details</a><% } %>
        <br />
        <%= listing.location %>, <%= listing.country %>
      </p>
      <% if (currUser && listing.phone) { %>
        <section class="contact-owner">
          <h4>Contact owner</h4>
          <p class="mb-2"><i class="fa-solid fa-phone"></i> <%= listing.phone %></p>
          <button class="btn btn-outline-dark copy-phone" type="button" data-phone="<%= listing.phone %>">
            <i class="fa-regular fa-copy"></i> Copy number
          </button>
          <span class="visually-hidden" aria-live="polite"></span>
        </section>
      <% } %>
    </div>
  </div>

  <!-- Edit and Delete Listing -->
  <% if (
    currUser &&
    listing.owner &&
    currUser._id.equals(listing.owner._id)
  ) { %>

    <div class="listing-actions col-md-8 offset-md-2 mt-3">
      <a
        href="/listings/<%= listing._id %>/edit"
        class="btn btn-dark edit-btn"
      >
        Edit
      </a>

      <form
        method="POST"
        action="/listings/<%= listing._id %>?_method=DELETE"
      >
        <button
          class="btn btn-dark"
          type="submit"
        >
          Delete
        </button>
      </form>
    </div>

  <% } %>

  <% const coordinates = listing.geometry?.coordinates; %>
  <% const hasMap = Array.isArray(coordinates) && coordinates.length === 2 && coordinates.every(Number.isFinite); %>
  <section class="col-md-8 offset-md-2 map-section mb-4">
    <h4 class="mb-3">Where you'll be</h4>
    <% if (hasMap) { %>
      <div id="map" aria-label="Map showing the approximate listing location"></div>
    <% } else { %>
      <p class="text-muted mb-0">Location map is currently unavailable for this listing.</p>
    <% } %>
  </section>

  <!-- Reviews Section -->
  <div class="col-md-8 offset-md-2 mb-3">
    <hr />

    <% if (currUser) { %>

      <h4>Leave a Review</h4>

      <form
        action="/listings/<%= listing._id %>/reviews"
        method="POST"
        novalidate
        class="needs-validation"
      >

        <!-- Star Rating -->
        <div class="mb-3 mt-3">
          <label class="form-label">Rating</label>

          <fieldset class="starability-slot">
            <legend>Choose your rating:</legend>

            <input
              type="radio"
              id="first-rate1"
              name="review[rating]"
              value="1"
              required
              checked
            />
            <label for="first-rate1" title="Terrible">
              1 star
            </label>

            <input
              type="radio"
              id="first-rate2"
              name="review[rating]"
              value="2"
            />
            <label for="first-rate2" title="Not good">
              2 stars
            </label>

            <input
              type="radio"
              id="first-rate3"
              name="review[rating]"
              value="3"
            />
            <label for="first-rate3" title="Average">
              3 stars
            </label>

            <input
              type="radio"
              id="first-rate4"
              name="review[rating]"
              value="4"
            />
            <label for="first-rate4" title="Very good">
              4 stars
            </label>

            <input
              type="radio"
              id="first-rate5"
              name="review[rating]"
              value="5"
            />
            <label for="first-rate5" title="Amazing">
              5 stars
            </label>
          </fieldset>
        </div>

        <!-- Review Comment -->
        <div class="mb-3 mt-3">
          <label for="comment" class="form-label">
            Comments
          </label>

          <textarea
            name="review[comment]"
            id="comment"
            cols="30"
            rows="5"
            class="form-control"
            required
          ></textarea>

          <div class="invalid-feedback">
            Please add some comments for your review.
          </div>
        </div>

        <button
          type="submit"
          class="btn btn-outline-dark"
        >
          Submit
        </button>

      </form>

    <% } else { %>

      <p>
        <a href="/login">Log in</a> to leave a review.
      </p>

    <% } %>

    <hr />

    <!-- All Reviews -->
    <h4>All Reviews</h4>

    <div class="row">

      <% if (!listing.reviews.length) { %><p class="text-muted">No reviews yet. Be the first to share your experience.</p><% } %>

      <% for (const review of listing.reviews) { %>

        <div class="card col-md-5 ms-md-3 mb-3">

          <div class="card-body">

            <h5 class="card-title">
              <%= review.author
                ? review.author.username
                : "Unknown user" %>
            </h5>

            <p class="card-text">
              <%= review.comment %>
            </p>

            <!-- Actual Review Rating -->
            <p
              class="starability-result"
              data-rating="<%= review.rating %>"
            >
              Rated: <%= review.rating %> out of 5 stars
            </p>

          </div>

          <!-- Delete Review: Only Author -->
          <% if (
            currUser &&
            review.author &&
            currUser._id.equals(review.author._id)
          ) { %>

            <form
              class="mb-3 ms-3"
              method="POST"
              action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
            >
              <button
                class="btn btn-sm btn-dark"
                type="submit"
              >
                Delete
              </button>
            </form>

          <% } %>

        </div>

      <% } %>

    </div>
  </div>
</div>

<% if (hasMap) { %>
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  />
  <script>
    window.listingMapData = <%- JSON.stringify({ title: listing.title, geometry: listing.geometry }).replace(/</g, "\\u003c").replace(/>/g, "\\u003e").replace(/&/g, "\\u0026") %>;
  </script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  <script src="/js/map.js"></script>
<% } %>

<script>
  document.querySelectorAll(".copy-phone").forEach((button) => {
    button.addEventListener("click", async () => {
      const phone = button.dataset.phone;
      const status = button.nextElementSibling;

      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(phone);
        } else {
          const input = document.createElement("textarea");
          input.value = phone;
          input.style.position = "fixed";
          input.style.opacity = "0";
          document.body.appendChild(input);
          input.select();
          const copied = document.execCommand("copy");
          input.remove();
          if (!copied) throw new Error("Copy command failed");
        }
        button.innerHTML = '<i class="fa-solid fa-check"></i> Copied';
        status.textContent = "Phone number copied.";
        setTimeout(() => {
          button.innerHTML = '<i class="fa-regular fa-copy"></i> Copy number';
        }, 1500);
      } catch {
        status.textContent = "Could not copy the phone number. Please select it manually.";
      }
    });
  });
</script>
