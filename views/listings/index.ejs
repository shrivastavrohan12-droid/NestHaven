<% layout("/layouts/boilerplate") %>
<%
  const categoryIcons = {
    Trending: "fa-fire", Rooms: "fa-bed", "Iconic Cities": "fa-city",
    Mountains: "fa-mountain", Castles: "fa-fort-awesome", Pools: "fa-person-swimming",
    Camping: "fa-campground", Farms: "fa-tractor", Arctic: "fa-snowflake",
    Snow: "fa-igloo", Boat: "fa-sailboat"
  };
  const queryFor = (category) => {
    const params = new URLSearchParams();
    if (search) params.set("search", search);
    if (category) params.set("category", category);
    const query = params.toString();
    return `/listings${query ? `?${query}` : ""}`;
  };
%>

<section class="listings-page py-4">
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
    <div>
      <p class="eyebrow mb-1">Find your next stay</p>
      <h1 class="mb-0"><%= selectedCategory || "Explore stays" %></h1>
    </div>
    <% if (search || selectedCategory) { %><a href="/listings" class="btn btn-outline-dark btn-sm">Clear filters</a><% } %>
  </div>

  <div class="listings-toolbar">
    <nav id="filters" aria-label="Listing categories">
      <a href="<%= queryFor("") %>" class="filter <%= !selectedCategory ? "active" : "" %>"><i class="fa-regular fa-compass"></i><span>Explore</span></a>
      <% categories.forEach((category) => { %>
        <a href="<%= queryFor(category) %>" class="filter <%= selectedCategory === category ? "active" : "" %>"><i class="fa-solid <%= categoryIcons[category] %>"></i><span><%= category %></span></a>
      <% }) %>
    </nav>
    <div class="tax-toggle form-check form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="taxSwitch" />
      <label class="form-check-label" for="taxSwitch">Display total after taxes</label>
    </div>
  </div>

  <% if (allListings.length) { %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 mt-1">
      <% allListings.forEach((listing) => { %>
        <div class="col"><a href="/listings/<%= listing._id %>" class="listing-link d-block h-100">
          <article class="card h-100 listing-card">
            <% if (listing.image?.url) { %><img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" /><% } %>
            <div class="card-body">
              <div class="d-flex justify-content-between gap-2"><h2 class="listing-title"><%= listing.title %></h2><span class="category-chip"><%= listing.category || "Trending" %></span></div>
              <p class="listing-location mb-1"><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></p>
              <p class="card-text mb-0"><strong>₹<%= listing.price.toLocaleString("en-IN") %></strong> / night <span class="tax-info">· ₹<%= Math.round(listing.price * 1.18).toLocaleString("en-IN") %> total</span></p>
            </div>
          </article>
        </a></div>
      <% }) %>
    </div>
  <% } else { %>
    <section class="empty-state text-center"><i class="fa-regular fa-compass"></i><h2><%= search ? `No stays found for “${search}”.` : "No listings in this category yet." %></h2><p>Try a different destination or explore all of NestHaven.</p><a href="/listings" class="btn btn-dark">Explore all stays</a></section>
  <% } %>
</section>
